generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InstagramAccount {
  id                   String    @id @default(cuid())
  instagramAccountId   String    @unique
  username             String
  name                 String?
  profilePictureUrl    String?
  accountType          String?
  encryptedAccessToken String?
  verifyToken          String
  isConnected          Boolean   @default(true)
  // AI assistent shu akkaunt uchun kelgan DM'larga avtomatik javob yozadimi.
  aiEnabled            Boolean   @default(false)
  tokenExpiresAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  conversations   Conversation[]
  academySettings AcademySettings?
  knowledgeBaseItems KnowledgeBaseItem[]
  branches        BranchInfo[]
  groups          GroupInfo[]
  promotions      PromotionInfo[]
  adCampaigns     AdCampaign[]
  adLeads         AdLead[]
}

// Har bir Instagram biznes akkaunti (o'quv markazi) uchun AI'ga o'rgatiladigan
// dinamik ma'lumotlar — kurslar, narxlar, manzil va h.k. Webhook shu jadvalni
// instagramAccountId orqali topib, AI system promptini shu asosda quradi.
model AcademySettings {
  id                 String   @id @default(cuid())
  instagramAccountId String   @unique
  academyName        String
  coursesAndPrices   String
  address            String
  phoneNumbers       String
  promotions         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
}

enum KnowledgeBaseCategory {
  COURSE
  GROUP
  PROMOTION
  PRICE
  BRANCH
  OTHER
}

enum PromotionScope {
  ALL_BRANCHES
  BRANCH
}

model BranchInfo {
  id                 String   @id @default(cuid())
  instagramAccountId  String
  name              String
  locationUrl       String
  workingHours      String
  phoneNumber       String
  subjectNames      String
  extraInfo         String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  groups    GroupInfo[]
  promotions PromotionInfo[] @relation("BranchPromotions")

  @@index([instagramAccountId, updatedAt])
  @@index([instagramAccountId, isActive])
}

model GroupInfo {
  id                 String   @id @default(cuid())
  instagramAccountId  String
  branchId          String
  subjectName       String
  price             String
  details           String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  branch  BranchInfo       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, branchId])
  @@index([instagramAccountId, updatedAt])
  @@index([instagramAccountId, isActive])
}

model PromotionInfo {
  id                 String         @id @default(cuid())
  instagramAccountId  String
  branchId          String?
  scope             PromotionScope @default(ALL_BRANCHES)
  title             String
  details           String
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  account InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  branch  BranchInfo?      @relation("BranchPromotions", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([instagramAccountId, branchId])
  @@index([instagramAccountId, updatedAt])
  @@index([instagramAccountId, isActive])
}

model AdCampaign {
  id                 String   @id @default(cuid())
  instagramAccountId String
  title              String
  metaPageId        String?
  metaPageName      String?
  metaFormId        String?  @unique
  metaFormName      String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  leads   AdLead[]

  @@index([instagramAccountId, updatedAt])
  @@index([instagramAccountId, isActive])
}

model AdLead {
  id                 String   @id @default(cuid())
  instagramAccountId String
  adCampaignId       String
  metaLeadId         String   @unique
  metaPageId         String?
  metaFormId         String?
  fullName           String
  phoneNumber        String?
  email              String?
  comment            String?
  rawFields          Json?
  leadCreatedAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account  InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  campaign AdCampaign       @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, createdAt])
  @@index([adCampaignId, createdAt])
  @@index([instagramAccountId, phoneNumber])
}

model KnowledgeBaseItem {
  id                 String                 @id @default(cuid())
  instagramAccountId  String
  title              String
  category           KnowledgeBaseCategory
  course             String?
  branch             String?
  details            String
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  account InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, category])
  @@index([instagramAccountId, isActive])
  @@index([instagramAccountId, updatedAt])
}

model Contact {
  id                String    @id @default(cuid())
  instagramScopedId String    @unique
  username          String?
  name              String?
  profilePictureUrl String?
  // Suhbat davomida AI (yoki admin) tomonidan aniqlangan aloqa raqami — ro'yxatdan
  // o'tish/kursga yozilish uchun mijoz qoldirgan telefon.
  phoneNumber       String?
  lastMessageAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversations Conversation[]
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum TalkStatus {
  TALKED
  NOT_TALKED
}

enum CourseDecision {
  WILL_WRITE
  WILL_NOT_WRITE
}

// Qo'ng'iroqlar bo'limi uchun: telefon raqam qoldirgan lidga admin qo'ng'iroq
// qilganmi-yo'qmi holatini kuzatish. talkStatus (chatda gaplashildimi) dan farqli —
// bu aynan TELEFON orqali bog'lanish holatini bildiradi.
enum CallStatus {
  NEW
  TALKED
  NOT_ANSWERED
}

model Conversation {
  id                 String             @id @default(cuid())
  instagramAccountId String
  contactId          String
  unreadCount        Int                @default(0)
  status             ConversationStatus @default(OPEN)
  leadTemperature    LeadTemperature    @default(WARM)
  talkStatus         TalkStatus         @default(NOT_TALKED)
  courseDecision     CourseDecision     @default(WILL_WRITE)
  callStatus         CallStatus         @default(NEW)
  // AI suhbatdan aniqlagan, mijoz qiziqish bildirgan fan/kurs nomi (erkin matn,
  // mijozning o'z so'zlari asosida) — Qo'ng'iroqlar bo'limida korsatish uchun.
  interestedCourse   String?
  // AI suhbatdan aniqlagan, mijoz yozilmoqchi bo'lgan filial nomi (erkin matn).
  interestedBranch   String?
  // AI suhbatdan aniqlagan, mijoz qulay deb aytgan dars vaqti/oralig'i (erkin matn,
  // masalan "8:00 dan 10:00 gacha").
  preferredTime      String?
  // Telegram lid kanaliga shu suhbat uchun xabar yuborilgan vaqt — telefon raqami birinchi
  // marta aniqlanganda BIR MARTA xabar yuborish uchun ishlatiladi (qayta yubormaslik uchun).
  leadNotifiedAt     DateTime?
  // Handover protokoli: mijoz operator so'raganda (yoki admin qo'lda) true bo'ladi — shu
  // suhbatda AI avtomatik javob yozishni to'xtatadi, toki admin qayta yoqmaguncha yoki
  // aiPausedAt'dan beri belgilangan vaqt o'tmaguncha (avtomatik qayta yoqilish).
  aiPaused           Boolean            @default(false)
  aiPausedAt         DateTime?
  // Mijoz "menga yozmang", "obunani bekor qiling" kabi avtomatik xabarlardan butunlay voz
  // kechish (opt-out) so'rovini bildirganda true bo'ladi. aiPaused'dan farqli o'laroq, bu
  // HECH QACHON avtomatik qayta yoqilmaydi (Meta talabi: foydalanuvchi doimiy ravishda
  // avtomatik xabarlardan bosh tortish imkoniga ega bo'lishi va bu so'rov darhol hurmat
  // qilinishi kerak) — faqat admin panel orqali qo'lda o'chirilishi mumkin.
  aiOptedOut         Boolean            @default(false)
  // Admin "AI xotirasini tozalash" tugmasini bosgan vaqt — shu vaqtdan OLDINGI xabarlar AI'ga
  // kontekst sifatida yuborilmaydi (getConversationHistory), shunda AI mijozni "yangi odam"
  // sifatida qayta boshlaydi. Xabarlarning o'zi chatda saqlanib qoladi, faqat AI'ning
  // "xotirasi" tozalanadi.
  aiMemoryResetAt    DateTime?
  lastMessageAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  account  InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact  Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([instagramAccountId, contactId])
  @@index([lastMessageAt])
}

enum SenderType {
  CONTACT
  ADMIN
}

enum MessageStatus {
  RECEIVED
  SENDING
  SENT
  FAILED
}

model Message {
  id                 String        @id @default(cuid())
  instagramMessageId String?       @unique
  conversationId     String
  senderType         SenderType
  text               String?
  attachmentType     String?
  attachmentUrl      String?
  // Instagram post/reel ulashilganda (attachmentUrl shunchaki sahifa havolasi bolgani uchun)
  // oEmbed orqali olingan va ozimizga yuklab olingan preview rasm.
  attachmentThumbnailUrl String?
  // Reaksiyalar: admin qoygani (platformadan) va kontakt qoygani (webhookdan).
  adminReaction      String?
  contactReaction    String?
  status             MessageStatus
  sentAt             DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}
