# ==== Server ====
NODE_ENV=development
PORT=4000

# ==== Database ====
DATABASE_URL=postgresql://instagram_dm:change-me@localhost:5432/instagram_dm

# ==== Auth ====
# Yaratish: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==== Access token shifrlash (AES-256) ====
# Aynan 64 ta hex belgi (32 bayt). Yaratish: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ==== Instagram / Meta ====
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=

# ==== AI Assistant (OpenAI) ====
# Berilmasa, AI auto-reply o'chiq holatda ishlaydi (xabarlar inson agentga qoladi).
OPENAI_API_KEY=

# ==== Telegram bot (lid xabarnomalari) ====
# @BotFather dan olingan token. Berilmasa, lid xabarnomalari jim o'chiq holatda ishlaydi.
TELEGRAM_BOT_TOKEN=
# Asosiy kanal/guruh chat ID (masalan -1001234567890).
TELEGRAM_CHANNEL_ID=
# Qo'shimcha kanal/guruhlar bo'lsa, vergul bilan ajratib shu yerga yozing — lid HAMMASIGA
# yuboriladi. Masalan: -1001111111111,-1002222222222
TELEGRAM_CHANNEL_IDS=

# ==== URLlar ====
FRONTEND_URL=http://localhost:3000
# Vergul bilan ajratilgan qo'shimcha allowed originlar
# Masalan: http://localhost:3000,http://127.0.0.1:3000,https://app.inboxcrm.uz
FRONTEND_URLS=
BACKEND_URL=http://localhost:4000
